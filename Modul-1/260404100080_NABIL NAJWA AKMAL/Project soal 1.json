                  {
                      "id":  2,
                      "type":  "input",
                      "text":  "harga_buku = 25000; jumlah_buku = 3; harga_pulpen = 8000; jumlah_pulpen = 2",
                      "x":  300,
                      "y":  130,
                      "w":  330,
                      "h":  110
                  },
                  {
                      "id":  3,
                      "type":  "input",
                      "text":  "harga_flashdisk = 75000; jumlah_flashdisk = 1; uang = 2 * 100000",
                      "x":  300,
                      "y":  272,
                      "w":  330,
                      "h":  110
                  },
                  {
                      "id":  4,
                      "type":  "process",
                      "text":  "total_buku = harga_buku * jumlah_buku",
                      "x":  330,
                      "y":  412,
                      "w":  262,
                      "h":  66
                  },
                  {
                      "id":  5,
                      "type":  "process",
                      "text":  "total_pulpen = harga_pulpen * jumlah_pulpen",
                      "x":  336,
                      "y":  500,
                      "w":  250,
                      "h":  66
                  },
                  {
                      "id":  6,
                      "type":  "process",
                      "text":  "total_flashdisk = harga_flashdisk * jumlah_flashdisk",
                      "x":  324,
                      "y":  588,
                      "w":  272,
                      "h":  66
                  },
                  {
                      "id":  7,
                      "type":  "process",
                      "text":  "total_belanja = total_buku + total_pulpen + total_flashdisk",
                      "x":  320,
                      "y":  676,
                      "w":  280,
                      "h":  66
                  },
                  {
                      "id":  8,
                      "type":  "process",
                      "text":  "diskon = total_belanja * 10 / 100",
                      "x":  336,
                      "y":  764,
                      "w":  250,
                      "h":  66
                  },
                  {
                      "id":  9,
                      "type":  "process",
                      "text":  "setelah_diskon = total_belanja - diskon",
                      "x":  320,
                      "y":  852,
                      "w":  280,
                      "h":  66
                  },
                  {
                      "id":  10,
                      "type":  "process",
                      "text":  "pajak = setelah_diskon * 11 / 100",
                      "x":  336,
                      "y":  940,
                      "w":  250,
                      "h":  66
                  },
                  {
                      "id":  11,
                      "type":  "process",
                      "text":  "total_bayar = setelah_diskon + pajak",
                      "x":  328,
                      "y":  1028,
                      "w":  266,
                      "h":  66
                  },
                  {
                      "id":  12,
                      "type":  "output",
                      "text":  "\"Total buku:\", total_buku; \"Total pulpen:\", total_pulpen; \"Total flashdisk:\", total_flashdisk",
                      "x":  300,
                      "y":  1120,
                      "w":  360,
                      "h":  132
                  },
                  {
                      "id":  13,
                      "type":  "output",
                      "text":  "\"Total belanja:\", total_belanja; \"Diskon 10%:\", diskon; \"Harga setelah diskon:\", setelah_diskon",
                      "x":  300,
                      "y":  1282,
                      "w":  360,
                      "h":  132
                  },
                  {
                      "id":  14,
                      "type":  "output",
                      "text":  "\"Pajak PPN 11%:\", pajak; \"Total bayar:\", total_bayar",
                      "x":  300,
                      "y":  1444,
                      "w":  360,
                      "h":  110
                  },
                  {
                      "id":  15,
                      "type":  "decision",
                      "text":  "uang \u003e= total_bayar",
                      "x":  330,
                      "y":  1610,
                      "w":  150,
                      "h":  150
                  },
                  {
                      "id":  16,
                      "type":  "process",
                      "text":  "kembalian = uang - total_bayar",
