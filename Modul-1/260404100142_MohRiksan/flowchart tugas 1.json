      "y": 234,
      "w": 180,
      "h": 66
    },
    {
      "id": 18,
      "type": "process",
      "text": "total_flashdisk = jumlah_flashdisk * harga_flashdisk",
      "x": 482,
      "y": 234,
      "w": 180,
      "h": 66
    },
    {
      "id": 19,
      "type": "process",
      "text": "total_belanja = total_buku + total_pulpen + total_flashdisk",
      "x": 716,
      "y": 237,
      "w": 180,
      "h": 66
    },
    {
      "id": 20,
